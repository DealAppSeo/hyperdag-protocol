{
  "name": "protocol",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/protocol/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsc -p tsconfig.json",
        "cwd": "packages/protocol"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --experimental-strip-types --no-warnings --test test/smoke.test.ts",
        "cwd": "packages/protocol"
      }
    }
  }
}

# Integration test environment manifest.
# Copy this file to tests/integration/.env.local (gitignored) and fill in values.
# Tests require REAL network access — no mocks. If a value is missing, the
# corresponding phase will skip with an explicit "env not configured" message.

# ── Base Sepolia (Phase 2 IIdentity, Phase 4 IValidation, Phase 8 composite) ──
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_PRIVATE_KEY=0x...                       # FUNDED test wallet only — do NOT use a production key
HYPERDAG_RECEIPT_ADAPTER_ADDRESS=0x6f3519cb9d0c2edc908e9d956538f20eb51b06cf
ERC8004_IDENTITY_REGISTRY_ADDRESS=0x8004A818BFB912233c491871b3d84c89A494BD9e

# ── Trinity Supabase (Phase 3 IReputation, Phase 4 IValidation, Phase 6 ILinkage) ──
SUPABASE_URL=https://qnnpjhlxljtqyigedwkb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...                     # service role key — never commit

# ── HAL (Phase 5 IHallucination) ──
